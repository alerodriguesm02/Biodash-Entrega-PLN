# Banco PostgreSQL público/gerenciado (Neon, Supabase, RDS etc.)
POSTGRES_URL=postgresql://usuario:senha@host:5432/biodash?sslmode=require

# Gere um valor longo e aleatório para assinar as sessões JWT
JWT_SECRET=substitua-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# A chave fica somente no backend. Apenas o áudio da transcrição é enviado à OpenAI.
OPENAI_API_KEY=sk-substitua-pela-sua-chave
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Armazenamento opcional de fotos de perfil
AWS_REGION=us-east-1
AWS_BUCKET_NAME=seu-bucket
AWS_ACCESS_KEY_ID=substitua-pela-access-key
AWS_SECRET_ACCESS_KEY=substitua-pela-secret-key

# Preencha após o primeiro deploy para permitir chamadas externas à API.
FRONTEND_URL=https://biodash-entrega-pln.vercel.app
NODE_ENV=production

# Recursos opcionais já existentes no backend
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
